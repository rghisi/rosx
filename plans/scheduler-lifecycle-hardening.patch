+    fn total_occurrences(strategy: &MlfqStrategy, handle: TaskHandle) -> usize {
+        strategy
+            .queues
+            .iter()
+            .map(|queue| queue.iter().filter(|&&h| h == handle).count())
+            .sum()
+    }
